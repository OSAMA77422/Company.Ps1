@model Department

@{
    ViewData["Title"] = "Details";
}

<h1>Details Page</h1>

<br />
<br />

<div>
    <div class="my-3">
        <label asp-for="Code" class="col-form-label"></label>
        <input asp-for="@Model.Code" class="form-control" readonly/>
    </div>   
    <div class="my-3">
        <label asp-for="Name" class="col-form-label"></label>
        <input asp-for="@Model.Name" class="form-control" readonly />
    </div>    
    <div class="my-3">
        <label asp-for="dateTime" class="col-form-label"></label>
        <input asp-for="@Model.dateTime" class="form-control" readonly />
    </div>

    <div class="my-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Index"class="text-danger">Back</a>
    </div>
</div>